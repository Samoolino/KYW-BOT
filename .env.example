# NEVER commit real credentials.
# The RPC URL in the supplied screenshot contained an Alchemy API key.
# Rotate that key if it is active, then put the replacement only in local
# environment/secret storage.

ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/REPLACE_ME
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/REPLACE_ME
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/REPLACE_ME
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/REPLACE_ME
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/REPLACE_ME
BSC_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/REPLACE_ME

# Optional read-only DEX aggregator key.
ZEROEX_API_KEY=REPLACE_ME

# Telegram notifications/control channel. Keep the bot token secret.
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME

# Email alerts (SMTP over TLS).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=alerts@example.com
SMTP_PASSWORD=REPLACE_ME
ALERT_EMAIL_TO=you@example.com

# Hummingbot Gateway wallet encryption passphrase.
# Do not reuse a seed phrase or private key here.
GATEWAY_PASSPHRASE=REPLACE_ME

# Session/risk controls.
SESSION_TARGET_PROFIT_USD=10
SESSION_STARTER_CAPITAL_USD=100
SESSION_AUTO_RESTART=false
